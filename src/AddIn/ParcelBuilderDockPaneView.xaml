                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Depth (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SelectedParcelCustomDepth, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Calculated Area" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Background="#091024" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedParcelArea, StringFormat='{}{0:N0} m²'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Visual Parcel Selector -->
                                <Border Background="#091024" CornerRadius="6" Padding="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="180">
                                    <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 6: EXCEPTIONS & OVERRIDES (ALL PARCELS DIMENSIONS & PREVIEW) -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep6, Converter={StaticResource BoolToVis}}">
                        <!-- Step Title & Subtitle -->
                        <TextBlock Text="6. Custom Exceptions &amp; Parcel Dimensions (أبعاد واستثناءات القطع)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Review all block parcel dimensions, customize individual frontage/depth overrides, and preview layout geometry." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- CARD 1: LIVE INTERACTIVE SCHEMATIC VECTOR PREVIEW -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📐 Interactive Block Preview (المعاينة التفاعلية للبلوك)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border Background="#16294D" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding AllGeneratedParcels.Count, StringFormat='Total Parcels: {0}'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                        <Border Background="#132338" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding BaseFrontage, StringFormat='Base: {0:F0}m × '}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                        <Border Background="#132338" CornerRadius="4" Padding="0,2,6,2">
                                            <TextBlock Text="{Binding BaseDepth, StringFormat='{}{0:F0}m'}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Interactive Vector Schematic Canvas -->
                                <Border Background="#091024" CornerRadius="8" Padding="6" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" Height="220" Margin="0,0,0,8">
                                    <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                </Border>

                                <TextBlock Text="💡 Click any parcel in the preview above or table below to select and adjust its specific frontage and depth." FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- CARD 2: SELECTED PARCEL QUICK DIMENSION EDITOR -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✏ Edit Selected Parcel (تعديل أبعاد القطعة المحددة): " FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Border Background="#16294D" CornerRadius="4" Padding="8,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding SelectedParcelId, FallbackValue='None'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="↺ Reset to Base (استعادة الأساسي)" Command="{Binding ResetSelectedParcelToStandardCommand}" Background="#162447" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="+ Add Exception (إضافة استثناء)" Command="{Binding AddExceptionCommand}" Background="#0E3A5A" Foreground="{StaticResource AccentCyanBrush}" FontSize="10" FontWeight="SemiBold" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Frontage Width / العرض (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SelectedParcelCustomFrontage, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Depth Length / العمق (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SelectedParcelCustomDepth, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Calculated Area / المساحة" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                        <Border Background="#091024" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding SelectedParcelArea, StringFormat='{}{0:N0} m²'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: COMPREHENSIVE ALL PARCELS DIMENSIONS BREAKDOWN -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="📋 All Block Parcels Dimensions (أبعاد وتفاصيل جميع قطع البلوك)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AllGeneratedParcels.Count, StringFormat='Total: {0} Lots'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Items List of All Parcels with Dimensions & Context Actions -->
                                <ItemsControl ItemsSource="{Binding AllGeneratedParcels}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Parcel Identifier Badge -->
                                                    <Border Grid.Column="0" Background="#14264A" CornerRadius="4" Padding="8,4" Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Id}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                                    </Border>

                                                    <!-- Dimension Metrics Summary -->
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Frontage, StringFormat='Frontage: {0:F1} m'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Depth, StringFormat='Depth: {0:F1} m'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding Area, StringFormat='Area: {0:N0} m²'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" Margin="0,0,12,0"/>
                                                        <Border Background="#162347" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Type}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Action Buttons: Split, Merge With Next, Edit / Select -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- Split Action -->
                                                        <Button Content="✂ Split" Command="{Binding DataContext.RowSplitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource OutlineActionButton}" Padding="8,4" FontSize="10" Margin="0,0,6,0" ToolTip="Split this parcel into two sub-parcels"/>
                                                        
                                                        <!-- Merge With Next Action -->
                                                        <Button Content="🔗 Merge Next" Command="{Binding DataContext.RowMergeWithNextCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" IsEnabled="{Binding CanMergeWithNext}" ToolTip="{Binding MergeNextValidationMessage}" Background="#112244" Foreground="{StaticResource AccentTealBrush}" BorderBrush="{StaticResource AccentTealBrush}" BorderThickness="1" Padding="8,4" FontSize="10" Margin="0,0,6,0" Cursor="Hand"/>
                                                        
                                                        <!-- Edit / Select Action -->
                                                        <Button Content="✏ Edit" Command="{Binding DataContext.SelectParcelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" Style="{StaticResource OutlineActionButton}" Padding="8,4" FontSize="10"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- CARD 4: ACTIVE PARCEL EXCEPTIONS SUMMARY -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="⚡ Active Custom Exceptions (الاستثناءات المخصصة النشطة)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ExceptionsList.Count, StringFormat='Exceptions Count: {0}'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Active Exceptions List -->
                                <ItemsControl ItemsSource="{Binding ExceptionsList}" Visibility="{Binding HasCustomExceptionsList, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#1E2A4A" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding ParcelIdentifier}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding CustomFrontage, StringFormat='Frontage: {0:F1}m'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding CustomDepth, StringFormat='Depth: {0:F1}m'}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0"/>
                                                        <TextBlock Text="{Binding CustomType}" FontSize="10" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Button Content="🗑 Delete (حذف)" Command="{Binding DataContext.DeleteExceptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ParcelIdentifier}" Background="#3A1414" Foreground="{StaticResource AccentRedBrush}" FontSize="10" FontWeight="SemiBold" Padding="8,4" HorizontalAlignment="Right" BorderThickness="0" Cursor="Hand"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty Exceptions Banner -->
                                <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Visibility="{Binding HasNoCustomExceptionsList, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✓ All parcels currently inherit standard base dimensions. Select any parcel from the preview or table above to customize." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 7: CORNER & CHAMFER GEOMETRY (COMPLETE REDESIGN)        -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep7, Converter={StaticResource BoolToVis}}">
                        <!-- Step Title & Subtitle -->
                        <TextBlock Text="7. Corner &amp; Chamfer Geometry (شطفات الأركان)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure outer corner parcels and chamfer cut methods (by street setbacks, direct length, or angle)." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- ======================================================== -->
                        <!-- CARD 1: CHAMFER DETAILS & CALCULATION METHODS           -->
                        <!-- (المستطيل الأول: تفاصيل وخيارات رسم الشطفة)             -->
                        <!-- ======================================================== -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="📐 Chamfer Parameters &amp; Calculation Method (خيارات وطرق الحساب)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding HasChamfer}" Content="Apply Corner Chamfer to Block (تفعيل الشطفة)" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <StackPanel Visibility="{Binding HasChamfer, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Select Chamfer Definition Method (طريقة تعريف الشطفة):" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,8"/>

                                    <!-- 4 Calculation Method Options in 2x2 Grid -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Option 1: Street Setbacks (أطوال أضلاع الشوارع واستنتاج الشطفة) -->
                                        <RadioButton Grid.Row="0" Grid.Column="0" Style="{StaticResource OptionCard}" IsChecked="{Binding IsActiveChamferByStreetSetbacks, Mode=TwoWay}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="1. Street Setback Distances" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Enter Main &amp; Cross street cuts; auto-deduce chamfer length (أطوال أضلاع الشارع واستنتاج الشطفة)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Option 2: Direct Chamfer Length (طول الشطفة المباشر) -->
                                        <RadioButton Grid.Row="0" Grid.Column="2" Style="{StaticResource OptionCard}" IsChecked="{Binding IsActiveChamferByDirectLength, Mode=TwoWay}" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="2. Direct Chamfer Face Length" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Enter diagonal chamfer hypotenuse with symmetric 45° cuts (طول الشطفة المباشر بزاوية 45°)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Option 3: Chamfer Length & Angle (طول الشطفة مع الزاوية) -->
                                        <RadioButton Grid.Row="1" Grid.Column="0" Style="{StaticResource OptionCard}" IsChecked="{Binding IsActiveChamferByLengthAndAngle, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="3. Chamfer Length &amp; Angle" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Specify cut face length and custom cut angle (طول الشطفة مع زاوية القص)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>

                                        <!-- Option 4: Primary Setback & Angle (مسافة الإزاحة مع الزاوية) -->
                                        <RadioButton Grid.Row="1" Grid.Column="2" Style="{StaticResource OptionCard}" IsChecked="{Binding IsActiveChamferBySetbackAndAngle, Mode=TwoWay}">
                                            <StackPanel>
                                                <TextBlock Text="4. Street Setback &amp; Angle" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                <TextBlock Text="Specify main street offset distance and cut angle (مسافة الإزاحة مع زاوية القص)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <!-- Form for Method 1: Street Setbacks -->
                                    <Grid Visibility="{Binding IsActiveChamferByStreetSetbacks, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Main Street Cut Distance / d1 (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerMainStreetSetback, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cross Street Cut Distance / d2 (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerCrossStreetSetback, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Form for Method 2: Direct Length -->
                                    <Grid Visibility="{Binding IsActiveChamferByDirectLength, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="Direct Chamfer Face Length / L (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerChamferLength, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Form for Method 3: Length & Angle -->
                                    <Grid Visibility="{Binding IsActiveChamferByLengthAndAngle, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chamfer Face Length / L (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerChamferLength, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cut Angle (° from Street Frontage)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerAngleDegrees, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Form for Method 4: Setback & Angle -->
                                    <Grid Visibility="{Binding IsActiveChamferBySetbackAndAngle, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Main Street Setback / d1 (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerPrimarySetback, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Cut Angle (° from Street Frontage)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ActiveCornerAngleDegrees, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Real-time Calculated Metrics Summary Bar -->
                                    <Border Background="#091024" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Calculated Chamfer Face (L)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding CalculatedChamferHypotenuseText, FallbackValue='5.66 m'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Effective Cut Angle (θ)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding CalculatedChamferAngleText, FallbackValue='45.0°'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Street Cut Setbacks (d1, d2)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding CalculatedStreetSetbacksText, FallbackValue='Main: 4.00 m | Cross: 4.00 m'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ======================================================== -->
                        <!-- CARD 2: CORNER PARCEL SELECTION & LIVE PREVIEW          -->
                        <!-- (المستطيل الثاني: تحديد الأركان والمعاينة التفاعلية)     -->
                        <!-- ======================================================== -->
                        <Border Style="{StaticResource CardPanel}" Visibility="{Binding HasChamfer, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🏛 Select Corner Parcels to Chamfer (تحديد أركان وقطع البلوك)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="✓ All 4 Corners (تحديد الكل)" Command="{Binding SelectAllCornersCommand}" Background="#164E8C" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" FontSize="10" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand"/>
                                        <Button Content="✕ Clear (إلغاء)" Command="{Binding ClearAllCornersCommand}" Background="#2A162B" Foreground="{StaticResource SecondaryTextBrush}" FontSize="10" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 4 Corner Parcel Selection Cards in 2x2 Grid -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Corner 1: Front-Left (Side A Start) -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding ApplyToSideAStart}" Content="Front-Left Corner (أعلى اليسار)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                                <TextBlock Text="Street A &amp; Left Cross Street" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                            </StackPanel>
                                            <Border Background="#16294D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FrontLeftHostParcelText, FallbackValue='Host: A-01'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Corner 2: Front-Right (Side A End) -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding ApplyToSideAEnd}" Content="Front-Right Corner (أعلى اليمين)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                                <TextBlock Text="Street A &amp; Right Cross Street" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                            </StackPanel>
                                            <Border Background="#16294D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FrontRightHostParcelText, FallbackValue='Host: A-End'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Corner 3: Back-Left (Side B Start) -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Visibility="{Binding IsBackToBack, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding ApplyToSideBStart}" Content="Back-Left Corner (أسفل اليسار)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                                <TextBlock Text="Street B &amp; Left Cross Street" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                            </StackPanel>
                                            <Border Background="#16294D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BackLeftHostParcelText, FallbackValue='Host: B-01'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Corner 4: Back-Right (Side B End) -->
                                    <Border Grid.Row="1" Grid.Column="2" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Visibility="{Binding IsBackToBack, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <StackPanel>
                                                <CheckBox IsChecked="{Binding ApplyToSideBEnd}" Content="Back-Right Corner (أسفل اليمين)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}" Cursor="Hand"/>
                                                <TextBlock Text="Street B &amp; Right Cross Street" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="20,2,0,0"/>
                                            </StackPanel>
                                            <Border Background="#16294D" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BackRightHostParcelText, FallbackValue='Host: B-End'}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Live Interactive Vector Schematic Container -->
                                <Border Background="#091024" CornerRadius="8" Padding="6" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" Height="240">
                                    <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 8: ELECTRIC ROOM / SUBSTATION (SPATIAL CONFIGURATION)   -->
                    <!-- ============================================================ -->
                    <!-- STEP 8: ELECTRIC ROOM / SUBSTATION (SPATIAL CONFIGURATION)   -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep8, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="8. Electric Room / Substation (غرفة المحول / الكهرباء)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentAmberDarkBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Place a street-aligned electrical room footprint, select placement interactively on map, and auto-carve host parcel geometries." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardPanel}" BorderBrush="{StaticResource AccentAmberDarkBrush}">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Electric Room Configuration (إعدادات غرفة المحول)" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                    <CheckBox IsChecked="{Binding HasElectricRoom}" Content="Include Electric Room / Substation (تضمين غرفة المحول)" Foreground="{StaticResource AccentAmberBrush}" FontWeight="Bold" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"/>
                                </Grid>

                                <StackPanel Visibility="{Binding HasElectricRoom, Converter={StaticResource BoolToVis}}">
                                    <!-- Dimensions Section -->
                                    <TextBlock Text="DIMENSIONS (الأبعاد)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Width Along Street (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ElectricRoomWidth, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Depth Into Parcel (m)" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ElectricRoomDepth, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Substation Area" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                            <Border Background="#091024" CornerRadius="6" Padding="10,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding ElectricRoomArea, StringFormat='{}{0:F2} m²'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Placement Street Section -->
                                    <TextBlock Text="PLACEMENT STREET (واجهة الشارع)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <RadioButton Grid.Column="0" Content="{Binding ElectricRoomSideLabelA}" IsChecked="{Binding IsElectricRoomSideA}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                        <RadioButton Grid.Column="2" Content="{Binding ElectricRoomSideLabelB}" IsChecked="{Binding IsElectricRoomSideB}" Visibility="{Binding IsBackToBack, Converter={StaticResource BoolToVis}}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                    </Grid>

                                    <!-- Placement Method & Interactive Trigger -->
                                    <TextBlock Text="PLACEMENT (تحديد الموقع)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="0" Command="{Binding SelectElectricRoomOnMapCommand}" Style="{StaticResource SolidTealButton}" Padding="16,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📍 " FontSize="13"/>
                                                <TextBlock Text="Select Location on Map (تحديد الموقع على الخريطة)" FontWeight="Bold" FontSize="11"/>
                                            </StackPanel>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="Manual Frontage Offset (m)" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ElectricRoomOffsetDistance, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Room Anchor / Reference Point Section (نقطة ارتكاز الغرفة للتموضع) -->
                                    <TextBlock Text="ROOM ANCHOR / REFERENCE POINT (نقطة ارتكاز الغرفة للتموضع)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,8"/>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Row 1: Street-front corners and center -->
                                        <RadioButton Grid.Row="0" Grid.Column="0" Content="Front-Left (أعلى يسار)" IsChecked="{Binding IsElectricRoomAnchorTopLeft}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8" ToolTip="Align room from its front-left corner along street"/>
                                        <RadioButton Grid.Row="0" Grid.Column="2" Content="Room Center (المنتصف)" IsChecked="{Binding IsElectricRoomAnchorCenter}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8" ToolTip="Align room from its center point"/>
                                        <RadioButton Grid.Row="0" Grid.Column="4" Content="Front-Right (أعلى يمين)" IsChecked="{Binding IsElectricRoomAnchorTopRight}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8" ToolTip="Align room from its front-right corner along street"/>

                                        <!-- Row 2: Inward corners -->
                                        <RadioButton Grid.Row="1" Grid.Column="0" Content="Back-Left (أسفل يسار)" IsChecked="{Binding IsElectricRoomAnchorBottomLeft}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" ToolTip="Align room from its rear-left corner"/>
                                        <RadioButton Grid.Row="1" Grid.Column="2" Content="Back-Right (أسفل يمين)" IsChecked="{Binding IsElectricRoomAnchorBottomRight}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" ToolTip="Align room from its rear-right corner"/>
                                    </Grid>

                                    <!-- Status & Relationship Container -->
                                    <TextBlock Text="STATUS &amp; HOST PARCEL RELATIONSHIP" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,8"/>
                                    <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Validation: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding ElectricRoomStatusText}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentMintBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsElectricRoomValid}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <TextBlock Text="Host Parcel(s): " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding ElectricRoomHostParcelsText}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Placement Type: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                    <Border Background="#16294D" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding ElectricRoomPlacementTypeText}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>

                                            <CheckBox Grid.Column="1" IsChecked="{Binding ElectricRoomClipHostParcels}" Content="Auto-clip footprint from host parcels" Foreground="{StaticResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>

                                    <!-- Live Schematic Canvas Preview -->
                                    <Grid Margin="0,4,0,8">
                                        <TextBlock Text="SCHEMATIC PREVIEW &amp; INTERACTIVE PLACEMENT (معاينة ونقاط التموضع التفاعلية)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="🔴 انقر على أي نقطة حمراء على الواجهة لتحديد موقع غرفة الكهرباء مباشرة" FontSize="11" Foreground="{StaticResource AccentAmberBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Background="#091024" CornerRadius="6" Padding="6" BorderBrush="{StaticResource AccentAmberDarkBrush}" BorderThickness="1" Height="220">
                                        <controls:SchematicCanvasControl Configuration="{Binding Config}" 
                                                                         SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" 
                                                                         ShowAnchorHandles="False"
                                                                         ShowElectricRoomHandles="True"
                                                                         SelectElectricRoomLocationCommand="{Binding SelectElectricRoomLocationCommand}"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 9: PARCEL SPLIT & MERGE (فرز ودمج القطع)                 -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep9, Converter={StaticResource BoolToVis}}">
                        <!-- Step Title & Subtitle -->
                        <TextBlock Text="9. Parcel Split &amp; Merge (فرز ودمج القطع)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Split a selected parcel into two lots or merge two adjacent parcels sharing a common boundary." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Mode Selector Card (Split Parcel vs Merge Parcels) -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="SELECT OPERATION MODE (نوع العملية)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0" Content="✂ Split Parcel (فرز / تقسيم قطعة)" IsChecked="{Binding IsSplitMode, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="12,10" FontSize="11" FontWeight="Bold"/>
                                    <RadioButton Grid.Column="2" Content="🔗 Merge Parcels (دمج قطعتين)" IsChecked="{Binding IsMergeMode, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="12,10" FontSize="11" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ==================== SPLIT PARCEL PANEL ==================== -->
                        <StackPanel Visibility="{Binding IsSplitMode, Converter={StaticResource BoolToVis}}">
                            <!-- 1. Selected Parcel Card -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="SELECTED PARCEL FOR SPLIT (القطعة المختارة)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <TextBlock Text="Click a parcel in the schematic preview below or on map" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Parcel ID" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding SelectedParcelId, FallbackValue='None'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Frontage" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding SelectedParcelFrontage, StringFormat='{}{0:F1} m', FallbackValue='- m'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Depth" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding SelectedParcelDepth, StringFormat='{}{0:F1} m', FallbackValue='- m'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Area" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                                <TextBlock Text="{Binding SelectedParcelArea, StringFormat='{}{0:N0} m²', FallbackValue='- m²'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Split Direction (Along Frontage vs Along Depth) -->
                                    <TextBlock Text="SPLIT DIRECTION (اتجاه الفرز)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" Content="Along Frontage (وفق الواجهة)" IsChecked="{Binding IsSplitAlongFrontage, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                        <RadioButton Grid.Column="2" Content="Along Depth (وفق العمق)" IsChecked="{Binding IsSplitAlongDepth, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                    </Grid>

                                    <!-- 3. Split Method (Equal vs Custom) & Position Dual Sliders -->
                                    <TextBlock Text="SPLIT METHOD &amp; DUAL POSITION (طريقة ونسبة وموضع القص)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,4,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton Grid.Column="0" Content="Equal Split (50/50 مناصفة)" IsChecked="{Binding IsSplitEqual, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                        <RadioButton Grid.Column="2" Content="Custom Split (مخصص)" IsChecked="{Binding IsSplitCustom, Mode=TwoWay}" Style="{StaticResource OptionCard}" Padding="10,8" FontSize="11"/>
                                    </Grid>

                                    <!-- Dual Percentage / Distance live controls -->
                                    <Border Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="8"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Percentage Control -->
                                            <StackPanel Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="Split Ratio (%)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SplitPercentage, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <!-- Distance Control -->
                                            <StackPanel Grid.Row="0" Grid.Column="2">
                                                <TextBlock Text="Cut Distance (m)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding SplitPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <!-- Min Dimension Threshold -->
                                            <StackPanel Grid.Row="0" Grid.Column="4">
                                                <TextBlock Text="Min Dimension (m)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,3"/>
                                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding MinDimensionThreshold, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>

                                            <!-- Percentage Slider -->
                                            <Slider Grid.Row="2" Grid.ColumnSpan="5" Minimum="1" Maximum="99" Value="{Binding SplitPercentage, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="False" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Grid>
                                    </Border>

                                    <!-- Non-blocking Warnings (Frontage & Chamfer) -->
                                    <Border Background="#261E0A" BorderBrush="{StaticResource AccentAmberDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding HasStreetFrontageWarning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚠️ " FontSize="12"/>
                                            <TextBlock Text="{Binding StreetFrontageWarningText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentAmberBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E233D" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="{Binding HasChamferWarning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📐 " FontSize="12"/>
                                            <TextBlock Text="{Binding ChamferWarningText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 4. Resulting Parcels Preview Summary -->
                                    <TextBlock Text="CALCULATED SUB-PARCELS PREVIEW (معاينة القطع الناتجة)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentMintBrush}" Margin="0,4,0,6"/>
                                    <Border Background="#091024" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SplitPreviewParcel1Text, StringFormat='Parcel 1: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,3"/>
                                            <TextBlock Text="{Binding SplitPreviewParcel2Text, StringFormat='Parcel 2: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Interactive Schematic Canvas Preview -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="LIVE SCHEMATIC SPLIT PREVIEW (المعاينة التخطيطية الفورية)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8"/>
                                    <Border Background="#091024" CornerRadius="6" Padding="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="220" Margin="0,0,0,12">
                                        <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                    </Border>

                                    <!-- Status Message & Action Buttons -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Status: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SplitMergeStatusText}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentMintBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSplitMergeValid}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel (إلغاء)" Command="{Binding CancelSplitMergeCommand}" Style="{StaticResource OutlineActionButton}" Padding="16,8" Margin="0,0,10,0"/>
                                            <Button Content="✂ Apply Split (تطبيق الفرز)" Command="{Binding ApplySplitCommand}" Style="{StaticResource SolidTealButton}" Padding="18,8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== MERGE PARCELS PANEL ==================== -->
                        <StackPanel Visibility="{Binding IsMergeMode, Converter={StaticResource BoolToVis}}">
                            <!-- 1. Selected Parcels Card -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="SELECTED PARCELS FOR MERGE (القطع المستهدفة للدمج)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                                        <TextBlock Text="Click two adjacent parcels on canvas or enter IDs" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <!-- Option to allow cross-side merge -->
                                    <CheckBox IsChecked="{Binding AllowDifferentSideMerge}" 
                                              Content="Allow Cross-Side / Spine Merge (السماح بالدمج بين الواجهتين / عبر الفاصل الخلفي)" 
                                              Foreground="{StaticResource AccentAmberBrush}" 
                                              FontWeight="Bold" FontSize="11" 
                                              Cursor="Hand" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Parcel 1 (First)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding MergeParcel1Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MergeParcel1Summary}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Background="#0C152E" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel>
                                                <TextBlock Text="Parcel 2 (Second)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding MergeParcel2Id, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding MergeParcel2Summary}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- 2. Resulting Merged Parcel Preview Summary -->
                                    <TextBlock Text="UNIFIED RESULTING PARCEL PREVIEW (معاينة القطعة المدمجة)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentMintBrush}" Margin="0,4,0,6"/>
                                    <Border Background="#091024" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding MergePreviewParcelText, StringFormat='Merged: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Interactive Schematic Canvas Preview -->
                            <Border Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="LIVE SCHEMATIC MERGE PREVIEW (المعاينة التخطيطية الفورية)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,8"/>
                                    <Border Background="#091024" CornerRadius="6" Padding="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="220" Margin="0,0,0,12">
                                        <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding MergeParcel1Id, Mode=TwoWay}" SelectedParcelId2="{Binding MergeParcel2Id, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                    </Border>

                                    <!-- Status Message & Action Buttons -->
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Status: " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SplitMergeStatusText}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentMintBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSplitMergeValid}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentRedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel (إلغاء)" Command="{Binding CancelSplitMergeCommand}" Style="{StaticResource OutlineActionButton}" Padding="16,8" Margin="0,0,10,0"/>
                                            <Button Content="🔗 Merge Selected Parcels (تطبيق الدمج)" Command="{Binding ApplyMergeCommand}" Style="{StaticResource SolidTealButton}" Padding="18,8"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 10: SPATIAL ALIGNMENT & ORIENTATION                     -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep10, Converter={StaticResource BoolToVis}}">
                        <!-- Step Title & Subtitle -->
                        <TextBlock Text="10. Spatial Alignment &amp; Orientation" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Define orientation baseline via 2 map points or reference parcel alignment." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Main Spatial Baseline Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Spatial Baseline &amp; Orientation" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Define block orientation and origin by picking 2 points with snapping, selecting an existing line / polygon boundary edge on the map, or centering in view." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- 3 Action Buttons Side-by-Side (Matching 08-Alignment.png) -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Style="{StaticResource OutlineActionButton}" Command="{Binding SetAlignmentCommand}" ToolTip="Click Point 1 then Point 2 on map with snapping">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✏ " FontSize="12"/>
                                            <TextBlock Text="2-Point Baseline (Snapping)" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="2" Style="{StaticResource OutlineActionButton}" Command="{Binding SetAlignmentFromFeatureCommand}" ToolTip="Click an existing line feature or polygon edge on map">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📏 " FontSize="12"/>
                                            <TextBlock Text="Pick Line / Polygon Edge" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="4" Style="{StaticResource SolidTealButton}" Command="{Binding MoveToMapExtentCommand}" ToolTip="Center block in active map view">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📍 " FontSize="12"/>
                                            <TextBlock Text="Move to Map Center" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- 4 Metric Columns (Bearing, Vector Length, Origin P1, Target P2) -->
                                <Border Background="#091024" CornerRadius="6" Padding="14,10" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Bearing (Azimuth)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding AlignmentAzimuthDegrees, StringFormat='{}{0:F1}°'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Vector Length" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding AlignmentVectorLengthText, FallbackValue='100.0 m'}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Origin Point (P1)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TwoPointP1Text, FallbackValue='(0.0, 0.0)'}" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="Target Point (P2)" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding TwoPointP2Text, FallbackValue='(100.0, 0.0)'}" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Dedicated Select Base Point on Map Button -->
                                <Button Content="📍 Select Base Point on Map (تحديد نقطة الأساس على الخريطة)" 
                                        Command="{Binding SelectBasePointOnMapCommand}" 
                                        Style="{StaticResource SolidTealButton}"
                                        HorizontalAlignment="Left" Margin="0,0,0,14"/>

                                <!-- Block Reference Anchor Point Section (Matching 08-Alignment.png) -->
                                <Grid Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="⚓ Block Reference Anchor Point: " FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Border Background="#16294D" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding SelectedBasePointDisplay, FallbackValue='Side A Start (Front-Left Corner)'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Select which block vertex aligns with map origin" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- 6 Anchor Cards in 3x2 Grid (Matching 08-Alignment.png) -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 1 -->
                                    <RadioButton Grid.Row="0" Grid.Column="0" Content="Front-Left (Side A Start)" IsChecked="{Binding IsAnchorSideAStart}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8"/>
                                    <RadioButton Grid.Row="0" Grid.Column="2" Content="Front-Right (Side A End)" IsChecked="{Binding IsAnchorSideAEnd}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8"/>
                                    <RadioButton Grid.Row="0" Grid.Column="4" Content="Street A Center" IsChecked="{Binding IsAnchorSideACenter}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,8"/>

                                    <!-- Row 2 -->
                                    <RadioButton Grid.Row="1" Grid.Column="0" Content="Back-Left (Side B Start)" IsChecked="{Binding IsAnchorSideBStart}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,0"/>
                                    <RadioButton Grid.Row="1" Grid.Column="2" Content="Back-Right (Side B End)" IsChecked="{Binding IsAnchorSideBEnd}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,0"/>
                                    <RadioButton Grid.Row="1" Grid.Column="4" Content="Block Centroid" IsChecked="{Binding IsAnchorBlockCenter}" Style="{StaticResource OptionCard}" FontSize="11" Padding="8,8" Margin="0,0,0,0"/>
                                </Grid>

                                <!-- Live Interactive Vector Schematic Container with Glowing Anchor -->
                                <Border Background="#091024" CornerRadius="8" Padding="6" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1" Height="240">
                                    <controls:SchematicCanvasControl Configuration="{Binding Config}" AnchorPoint="{Binding AnchorPoint}" ShowAnchorHandles="True"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 11: DYNAMIC PREVIEW & INSPECTION (MATCHING 09-DYNAMIC)  -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep11, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="11. Dynamic Preview &amp; Inspection" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Inspect individual parcel dimensions, areas, and interactive vector layout schematic." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <!-- Top Toolbar Banner -->
                        <Border Background="#101A36" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗺 " FontSize="14"/>
                                    <StackPanel>
                                        <TextBlock Text="ArcGIS Pro Map Preview &amp; Zoom Window" FontWeight="Bold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Live synchronized map viewport overlay and spatial bounding controls" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SolidTealButton}" Content="📍 Move to Map Extent" Command="{Binding MoveToMapExtentCommand}" FontSize="10" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource OutlineActionButton}" Content="🔍 Zoom Block Extent" Command="{Binding ZoomBlockExtentCommand}" FontSize="10" Padding="8,5" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource OutlineActionButton}" Content="🔍 Zoom Selected" Command="{Binding ZoomSelectedParcelCommand}" FontSize="10" Padding="8,5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Dynamic Vector Schematic -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Dynamic Vector Schematic" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <TextBlock Text="Click to inspect parcel" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border Background="#091024" CornerRadius="6" Padding="6" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Height="260">
                                        <controls:SchematicCanvasControl Configuration="{Binding Config}" SelectedParcelId="{Binding SelectedParcelId, Mode=TwoWay}" ShowAnchorHandles="False"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Right: Parcel Inspection Details & Block Metrics -->
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardPanel}">
                                    <StackPanel>
                                        <TextBlock Text="Parcel Inspection Details" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Parcel ID" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedParcelId}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Side &amp; Type" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedParcelSideLabel}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Frontage" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedParcelFrontage, StringFormat='{}{0:F1} m'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Depth" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedParcelDepth, StringFormat='{}{0:F1} m'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Area" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding SelectedParcelArea, StringFormat='{}{0:N0} m²'}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource CardPanel}">
                                    <StackPanel>
                                        <TextBlock Text="Block Metrics" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,8"/>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Block Length" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding EstimatedBlockLength, StringFormat='~ {0:F0} m'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid>
                                            <TextBlock Text="Total Area" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding EstimatedBlockArea, StringFormat='{}{0:N0} m²'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 12: VALIDATION & GEOMETRY RULES (MATCHING 10-VALIDATION)-->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep12, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="12. Validation &amp; Geometry Rules" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Review geometric integrity, topological checks, and validation error warnings." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Geometry &amp; Parameter Rules Validation" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,12"/>

                                <!-- Success Banner (Zero Errors & Zero Warnings) -->
                                <Border Background="#0D2E24" BorderBrush="#00BFA5" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding IsValidationAllClean, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="✓ Configuration and geometry rules passed with zero blocking errors." FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentMintBrush}"/>
                                </Border>

                                <!-- Warning Banner (Warnings Exist, Zero Blocking Errors) -->
                                <Border Background="#261E0A" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding HasValidationWarnings, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="⚠ Configuration passed with cadastre warnings. Review warnings below before proceeding." FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource AccentAmberBrush}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Error Banner (Blocking Errors Exist) -->
                                <Border Background="#2E1018" BorderBrush="#FF5252" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14" Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="✕ Configuration has blocking validation errors. Please resolve them before generating output." FontWeight="SemiBold" FontSize="11" Foreground="#FF5252"/>
                                    </StackPanel>
                                </Border>

                                <!-- Blocking Errors List (if any) -->
                                <ItemsControl ItemsSource="{Binding ValidationErrors}" Visibility="{Binding HasValidationErrors, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1C0E14" BorderBrush="#8C1F32" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="✕ " FontWeight="Bold" FontSize="12" Foreground="#FF5252" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="#FFCDD2" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Explicit Rules List (10 Cadastre Rules + Substation & Alignment) -->
                                <ItemsControl ItemsSource="{Binding RuleValidationItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CardBackground}" BorderBrush="{Binding CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusIcon}" FontWeight="Bold" FontSize="12" Foreground="{Binding StatusColor}" Margin="0,0,10,0"/>
                                                        <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource PrimaryTextBrush}"/>
                                                    </StackPanel>
                                                    
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding StatusColor}" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                    <!-- Detailed Rule Status Explanation -->
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Details}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" Margin="22,4,0,0" TextWrapping="Wrap"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============================================================ -->
                    <!-- STEP 13: FINAL REVIEW & OUTPUT (MATCHING 11-FINAL)           -->
                    <!-- ============================================================ -->
                    <StackPanel Visibility="{Binding IsStep13, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="12. Final Review &amp; Feature Class Output" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="Review the final configuration summary blueprint and export to Geodatabase Feature Class." FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Configuration Summary Blueprint -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Configuration Summary Blueprint" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Source Mode" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding SourceModeText, FallbackValue='Manual'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Relationship" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding RelationshipText, FallbackValue='PartOfBlock'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Arrangement" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ArrangementText, FallbackValue='BackToBack'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Side A Count" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding SideACount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Side B Count" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding SideBCount}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPurpleBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Base Dimensions" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding BaseDimensionsText, FallbackValue='20 m × 30 m'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Chamfer Status" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ChamferStatusText, FallbackValue='False'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <Grid>
                                        <TextBlock Text="Electric Room Status" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <TextBlock Text="{Binding ElectricRoomStatusText, FallbackValue='None'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Right: Output Destination & Big Action Button -->
                            <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                                <StackPanel>
                                    <TextBlock Text="Output Destination" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PrimaryTextBrush}" Margin="0,0,0,14"/>

                                    <TextBlock Text="Feature Class Name" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding OutputFeatureClassName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

                                    <TextBlock Text="Target Geodatabase / Workspace" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding TargetGdbPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,18"/>

                                    <Button Command="{Binding GenerateFeatureClassCommand}" Background="{StaticResource AccentTealBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" FontSize="13" Padding="16,12" Height="44" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="⚙ " FontSize="14"/>
                                                        <TextBlock Text="Generate Feature Class Now" FontWeight="Bold" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3. BOTTOM FOOTER NAVIGATION BAR                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="2" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Reset & Back -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↺ Reset" Command="{Binding ResetDefaultsCommand}" Background="#162447" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11" Padding="12,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="← Back" Command="{Binding PreviousStepCommand}" Background="#162447" Foreground="{StaticResource SecondaryTextBrush}" FontWeight="SemiBold" FontSize="11" Padding="12,6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>

                <!-- Middle: Status Message -->
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource AccentMintBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="14,0"/>

                <!-- Right: Next & Generate -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Next →" Command="{Binding NextStepCommand}" Background="#164E8C" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" FontSize="11" Padding="14,6" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Generate Feature Class" Command="{Binding GenerateFeatureClassCommand}" Background="{StaticResource AccentTealBrush}" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="Bold" FontSize="11" Padding="14,6" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
