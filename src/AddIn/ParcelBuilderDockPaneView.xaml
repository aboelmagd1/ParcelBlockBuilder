<UserControl x:Class="ParcelBuilder.AddIn.ParcelBuilderDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ParcelBuilder.AddIn"
             xmlns:controls="clr-namespace:ParcelBuilder.AddIn.Controls"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1100"
             FlowDirection="{Binding FlowDirection}"
             Background="#070D1E" Foreground="#FFFFFF"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- ============================================================ -->
        <!-- CENTRALIZED HIGH-CONTRAST PALETTE (WCAG AAA COMPLIANT)       -->
        <!-- ============================================================ -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#94A3B8"/>
        <SolidColorBrush x:Key="DimTextBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="AccentCyanBrush" Color="#00E5FF"/>
        <SolidColorBrush x:Key="AccentTealBrush" Color="#00BFA5"/>
        <SolidColorBrush x:Key="AccentMintBrush" Color="#A7F3D0"/>
        <SolidColorBrush x:Key="AccentAmberBrush" Color="#FFB74D"/>
        <SolidColorBrush x:Key="AccentAmberDarkBrush" Color="#FF9100"/>
        <SolidColorBrush x:Key="AccentRedBrush" Color="#FF5252"/>
        <SolidColorBrush x:Key="AccentRedLightBrush" Color="#FF8A80"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#29B6F6"/>
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#AB47BC"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#101A36"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#1C2B54"/>
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#0C152E"/>
        <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#0B132B"/>
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#081026"/>

        <!-- ============================================================ -->
        <!-- IMPLICIT CONTROL STYLES (OVERRIDING ARCGIS PRO AMBIENT LIGHT)-->
        <!-- ============================================================ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Standard Card Container Style -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Option Selection Card Style (Radio) -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="#111A33" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" TextElement.Foreground="{StaticResource PrimaryTextBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="radioCircle" Grid.Column="0" Width="18" Height="18" CornerRadius="9" BorderBrush="#3D507A" BorderThickness="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Ellipse x:Name="radioDot" Width="8" Height="8" Fill="{StaticResource AccentCyanBrush}" Visibility="Collapsed"/>
                                </Border>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" TextElement.Foreground="{StaticResource PrimaryTextBrush}"/>
                                <TextBlock x:Name="checkIcon" Grid.Column="2" Text="✓" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" Visibility="Collapsed" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#14264A"/>
                                <Setter TargetName="radioCircle" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                <Setter TargetName="radioDot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="checkIcon" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#192447"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Dark TextBox Style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"/>

        <!-- Stepper Button Style -->
        <Style x:Key="StepNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#172445"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary Outline Action Button Style -->
        <Style x:Key="OutlineActionButton" TargetType="Button">
            <Setter Property="Background" Value="#0E244A"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#173B75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Solid Teal Action Button Style -->
        <Style x:Key="SolidTealButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentTealBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF"/>
                    <Setter Property="Foreground" Value="#0B132B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Boolean to Visibility Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Stepper + Form Workstation -->
            <RowDefinition Height="*"/>
            <!-- Bottom Footer Navigation Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. TOP HEADER BAR                                             -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentTealBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,12,0">
                        <TextBlock Text="❖" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Parcel Builder Workstation" FontWeight="Bold" FontSize="15" Foreground="{StaticResource PrimaryTextBrush}"/>
                        <TextBlock Text="Create blocks from parameters or extract from GIS parcels" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Undo / Redo Buttons -->
                    <Border Background="#131F3F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4,2" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding UndoCommand}" ToolTip="Undo last action (↶)" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↶" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,3,0"/>
                                    <TextBlock Text="Undo" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="|" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                            <Button Command="{Binding RedoCommand}" ToolTip="Redo action (↷)" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↷" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,3,0"/>
                                    <TextBlock Text="Redo" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Background="#131F3F" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding IsLivePreviewEnabled}" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand"/>
                            <TextBlock Text="Map Overlay" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#172445" CornerRadius="12" Padding="4,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding SetEnglishCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="EN" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnglish}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>

                            <TextBlock Text="|" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="2,0"/>

                            <Button Command="{Binding SetArabicCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="6,2">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="العربية" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsArabic}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- 2. MAIN SPLIT WORKSTATION (STEPPER SIDEBAR + ACTIVE STEP)     -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Stepper Navigation Sidebar -->
                <ColumnDefinition Width="235"/>
                <!-- Divider -->
                <ColumnDefinition Width="1"/>
                <!-- Right Step Form Area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT STEPPER SIDEBAR (13 STEPS) -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}" Padding="10,12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding StepperHeaderTitle}" FontWeight="Bold" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,10"/>

                        <!-- Step 1 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>1</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="1" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StepNavTitle1}" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep1}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Step 2 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>2</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="2" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StepNavTitle2}" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep2}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Step 3 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>3</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="3" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StepNavTitle3}" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep3}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Step 4 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>4</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="4" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StepNavTitle4}" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep4}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Step 5 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>5</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="5" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock Text="{Binding StepNavTitle5}" VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep5}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Step 6 -->
                        <Button Style="{StaticResource StepNavButton}" Command="{Binding GoToStepCommand}">
                            <Button.CommandParameter><sys:Int32>6</sys:Int32></Button.CommandParameter>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="20" Height="20" CornerRadius="10" Margin="0,0,10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#162347"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStep6}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentCyanBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="6" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStep6}" Value="True">
                                                        <Setter Property="Foreground" Value="#0B132B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
